# PostgreSQL
POSTGRES_USER=flexdesk
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=flexdesk
POSTGRES_PORT=5432

# Backend connection string (built from the values above)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=flexdesk;Username=flexdesk;Password=change_me_in_local_env

# JWT (use a long random secret, at least 32 characters)
Jwt__Secret=change_me_to_a_long_random_secret_value
Jwt__Issuer=FlexDesk
Jwt__Audience=FlexDeskClient
Jwt__ExpiryMinutes=60
